{
  "name": "finance-investor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "quality:changed": "bun scripts/quality_changed.ts",
    "quality:ts": "bun scripts/quality_changed.ts --ts-only",
    "quality:python": "bun scripts/quality_changed.ts --python-only",
    "format:check:all": "biome ci --config-path=config/biome.json src tests scripts",
    "lint:all": "oxlint src tests scripts",
    "test": "bun test tests/*.test.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "edinet": "bun scripts/edinet_cli.ts",
    "jquants:warm-cache": "bun scripts/jquants_cache_warm.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@playwright/test": "^1.58.2",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.2",
    "@types/xml2js": "^0.4.14",
    "oxlint": "1.76.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "apache-arrow": "^21.1.0",
    "better-sqlite3": "^12.8.0",
    "hono": "^4.12.8",
    "js-yaml": "^4.1.1",
    "pg": "^8.19.0",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  }
}
