{
  "decision_thresholds": {
    "review": {
      "min_investment_relevance_terms": 1
    },
    "select": {
      "min_empirical_or_data_terms": 1,
      "min_investment_relevance_terms": 2,
      "min_method_terms": 1
    }
  },
  "forbidden_decision_inputs": [
    "citation_count",
    "citations",
    "current_citations",
    "journal_ref",
    "later_journal_outcome",
    "post_2021_performance"
  ],
  "purpose": "Deterministic ex-post metadata-only prioritization for paper-level inspection. It does not reconstruct a 2021-vintage ranking and does not validate alpha.",
  "required_metadata": [
    "arxiv_id",
    "title",
    "abstract",
    "published",
    "primary_category",
    "categories",
    "abs_url"
  ],
  "schema_version": "investor2.arxiv-qfin-selector-rules.v1",
  "score_weights": {
    "empirical_or_data": 2,
    "investment_relevance": 4,
    "method": 2,
    "oos": 2,
    "pit_data": 1,
    "transaction_cost": 1
  },
  "selector_version": "1.0.0",
  "stable_tie_breaker": [
    "decision_rank",
    "priority_score_desc",
    "arxiv_id_asc"
  ],
  "term_groups": {
    "empirical_or_data": [
      "data",
