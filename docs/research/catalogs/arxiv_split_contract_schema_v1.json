{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investor2.arxiv-split-contract.v1",
  "title": "arXiv empirical reproduction split contract",
  "type": "object",
  "required": [
    "arxiv_id",
    "selected_version",
    "selected_version_url",
    "extraction_status",
    "sample_window",
    "train_window",
    "validation_window",
    "test_window",
    "split_semantics",
    "feature_lookbacks",
    "warmup_policy",
    "retraining_cadence",
    "overlap_rule",
    "embargo_rule",
    "model_selection_rule",
    "benchmark_evaluation_window",
    "transaction_cost_evaluation_window",
    "sample_selection_filters",
    "not_specified_fields",
    "unresolved_blockers",
    "evidence_locations"
  ],
  "properties": {
    "extraction_status": {"enum": ["VERIFIED_FULL_TEXT", "FAIL_CLOSED_NOT_EXTRACTED"]},
    "split_semantics": {"enum": ["EXPANDING", "ROLLING", "FIXED", "RANDOM", "NOT_SPECIFIED"]},
    "not_specified_fields": {"type": "array"},
    "unresolved_blockers": {"type": "array"},
    "evidence_locations": {"type": "array"}
  },
  "additionalProperties": true
}
