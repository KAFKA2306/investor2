{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investor2.arxiv-data-requirement-contract.v1",
  "title": "arXiv empirical reproduction data requirement contract",
  "type": "object",
  "required": [
    "arxiv_id",
    "selected_version",
    "selected_version_url",
    "extraction_status",
    "instrument_universe",
    "market_venue",
    "asset_classes",
    "raw_observations",
    "derived_features",
    "observation_frequency",
    "source_named_by_paper",
    "access_status",
    "transformation_prerequisites",
    "transaction_cost_inputs",
    "benchmark_inputs",
    "unresolved_blockers",
    "evidence_locations"
  ],
  "properties": {
    "arxiv_id": {"type": "string"},
    "selected_version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "selected_version_url": {"type": "string"},
    "extraction_status": {"enum": ["VERIFIED_FULL_TEXT", "FAIL_CLOSED_NOT_EXTRACTED"]},
    "instrument_universe": {},
    "market_venue": {},
    "asset_classes": {"type": "array"},
    "raw_observations": {"type": "array"},
    "derived_features": {"type": "array"},
    "observation_frequency": {},
    "source_named_by_paper": {},
    "access_status": {"enum": ["PUBLIC", "PROPRIETARY", "UNAVAILABLE", "AMBIGUOUS"]},
    "transformation_prerequisites": {"type": "array"},
    "transaction_cost_inputs": {"type": "array"},
    "benchmark_inputs": {"type": "array"},
    "unresolved_blockers": {"type": "array"},
    "evidence_locations": {"type": "array"}
  },
  "additionalProperties": true
}
